// Firebase Security Rules for Firestore
// Käytä näitä sääntöjä Firebase Console -> Firestore Database -> Rules
//
// HUOM: kaikki kokoelmat luetellaan erikseen, koska Firestoren säännöt ovat
// OR-tyyppisiä: aiempi catch-all `match /{document=**}` olisi ohittanut
// events-kokoelman rajoitukset kokonaan.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function numOr(data, key, fallback) {
      return data.get(key, fallback) is number ? data.get(key, fallback) : fallback;
    }

    // Kokoonpanon koko. Jos kenttä puuttuu tai on väärää tyyppiä -> 0.
    function rosterSize(data) {
      return data.get('registeredPlayers', []) is list
        ? data.get('registeredPlayers', []).size()
        : 0;
    }

    // Lisäpelaajat (enintään 2) eivät vie paikkaa: kukin kasvattaa
    // kapasiteettia yhdellä. Kelpaavat vain ilmoittautuneet, jotka on merkitty
    // tapahtuman joukkueessa lisäpelaajiksi, ettei rajaa voi kiertää.
    function extraIds(data) {
      return data.get('extraPlayerIds', []) is list
        ? data.get('extraPlayerIds', [])
        : [];
    }

    function isTeamExtra(data, userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data
             .get('extraPlayer', {}).get(data.get('teamId', ''), false) == true;
    }

    function extraCount(data) {
      let ids = extraIds(data);
      return ids.size() <= 2
          && data.get('registeredPlayers', []).hasAll(ids)
          && (ids.size() < 1 || isTeamExtra(data, ids[0]))
          && (ids.size() < 2 || isTeamExtra(data, ids[1]))
        ? ids.size()
        : 0;
    }

    // Paikkojen kokonaismäärä (kenttäpelaajat + maalivahdit + lisäpelaajat).
    // Jos rajoja ei ole asetettu, ei rajoiteta (fail-open, ettei vanha data lukkiudu).
    function rosterCapacity(data) {
      return numOr(data, 'maxPlayers', 9999) + numOr(data, 'maxGoalkeepers', 0)
        + extraCount(data);
    }

    // Kirjoitus sallitaan jos kokoonpano mahtuu rajoihin TAI jos kokoonpano ei
    // kasva. Jälkimmäinen sallii korjaukset ja poistot tapahtumissa, joissa raja
    // on jo ylittynyt, sekä kaikki muut kentät koskevat päivitykset.
    // Kasvamattomuus tarkistetaan ensin: silloin lisäpelaajien
    // käyttäjädokumentteja ei tarvitse lukea.
    function eventRosterOk() {
      return (resource != null
            && rosterSize(request.resource.data) <= rosterSize(resource.data))
        || rosterSize(request.resource.data) <= rosterCapacity(request.resource.data);
    }

    match /events/{eventId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && rosterSize(request.resource.data) <= rosterCapacity(request.resource.data);
      allow update: if signedIn() && eventRosterOk();
      allow delete: if signedIn();
    }

    // Kirjautumispolku korvasi kerran käyttäjädokumentin minimitietueella,
    // kun dokumentin luku palautti tyhjän ennen kuin verkko oli pystyssä.
    // Client on korjattu, mutta tämä suojaa myös niitä laitteita, joilla on
    // vielä vanha nippu: profiilikenttää ei voi pyyhkiä pois kirjoittamalla
    // dokumentin ilman sitä.
    function keepsField(name) {
      return !(name in resource.data) || (name in request.resource.data);
    }

    function keepsProfile() {
      return keepsField('positions')
        && keepsField('teamIds')
        && keepsField('teamMember')
        && keepsField('teamSkills')
        && keepsField('isAdmin')
        && keepsField('isMasterAdmin');
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn() && keepsProfile();
      allow delete: if signedIn();
    }
    match /teams/{teamId} {
      allow read, write: if signedIn();
    }
    match /teamPlayers/{docId} {
      allow read, write: if signedIn();
    }
    match /teamCreationRequests/{docId} {
      allow read, write: if signedIn();
    }
    match /players/{playerId} {
      allow read, write: if signedIn();
    }
    match /licenses/{licenseId} {
      allow read, write: if signedIn();
    }
    match /licenseRequests/{requestId} {
      allow read, write: if signedIn();
    }
    match /messages/{messageId} {
      allow read, write: if signedIn();
    }

    // Ilmoitustaulu: kaikki kirjautuneet lukevat, vain joukkueen admin (tai
    // master admin) kirjoittaa. Joukkuetta ei voi vaihtaa sellaiseen, jonka
    // admin kirjoittaja ei ole.
    function isMasterAdmin() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path)
        && (get(path).data.get('isMasterAdmin', false) == true
            || get(path).data.get('masterAdmin', false) == true);
    }

    function isTeamAdmin(teamId) {
      let path = /databases/$(database)/documents/teams/$(teamId);
      return exists(path)
        && (get(path).data.get('adminIds', []).hasAny([request.auth.uid])
            || get(path).data.get('adminId', '') == request.auth.uid);
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && (isTeamAdmin(request.resource.data.teamId) || isMasterAdmin());
      allow update: if signedIn()
        && (isMasterAdmin()
            || (isTeamAdmin(resource.data.teamId)
                && isTeamAdmin(request.resource.data.teamId)));
      allow delete: if signedIn()
        && (isTeamAdmin(resource.data.teamId) || isMasterAdmin());
    }
    match /settings/{settingId} {
      allow read, write: if signedIn();
    }
  }
}
